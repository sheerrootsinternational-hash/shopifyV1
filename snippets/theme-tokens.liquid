{%- comment -%}
  Renders the theme's design tokens as CSS custom properties.

  Every value here comes from Theme settings, so a merchant can restyle the whole
  storefront without touching code. Colour schemes are expressed as classes that
  re-point the same variables, which lets any section opt into Ivory / Sand / Ink
  without duplicating component CSS.
{%- endcomment -%}

{% style %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    /* Type */
    --font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading-style: {{ settings.type_heading_font.style }};
    --font-heading-weight: {{ settings.type_heading_font.weight }};
    --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body-style: {{ settings.type_body_font.style }};
    --font-body-weight: {{ settings.type_body_font.weight }};
    --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};

    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
    --heading-transform: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};
    --heading-tracking: {{ settings.heading_letter_spacing | divided_by: 100.0 }}em;

    /* Palette */
    --color-ivory-bg: {{ settings.color_background }};
    --color-sand-bg: {{ settings.color_background_alt }};
    --color-ink-bg: {{ settings.color_ink }};
    --color-ink-fg: {{ settings.color_on_ink }};
    --color-primary-text: {{ settings.color_text }};
    --color-secondary-text: {{ settings.color_text_muted }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-rgb: {{ settings.color_accent | color_extract: 'red' }}, {{ settings.color_accent | color_extract: 'green' }}, {{ settings.color_accent | color_extract: 'blue' }};
    --color-line: {{ settings.color_border }};
    --color-button-bg: {{ settings.color_button }};
    --color-button-fg: {{ settings.color_button_text }};

    /* Scheme defaults — overridden by .scheme-* below */
    --bg: var(--color-ivory-bg);
    --fg: var(--color-primary-text);
    --fg-muted: var(--color-secondary-text);
    --fg-rgb: {{ settings.color_text | color_extract: 'red' }}, {{ settings.color_text | color_extract: 'green' }}, {{ settings.color_text | color_extract: 'blue' }};
    --line: var(--color-line);
    --accent: var(--color-accent);
    --btn-bg: var(--color-button-bg);
    --btn-fg: var(--color-button-fg);

    /* Layout */
    --page-width: {{ settings.page_width }}px;
    --page-width-narrow: 820px;
    --gutter: 2rem;
    --gutter-lg: 4rem;
    --radius: {{ settings.border_radius }}px;
    --radius-pill: 999px;
    --spacing-scale: {{ settings.spacing_scale | divided_by: 100.0 }};

    /* Motion */
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
    --duration: 320ms;

    /* Focus */
    --focus-ring: 2px;
  }

  .scheme-ivory {
    --bg: var(--color-ivory-bg);
    --fg: var(--color-primary-text);
    --fg-muted: var(--color-secondary-text);
    --fg-rgb: {{ settings.color_text | color_extract: 'red' }}, {{ settings.color_text | color_extract: 'green' }}, {{ settings.color_text | color_extract: 'blue' }};
    --line: var(--color-line);
    --btn-bg: var(--color-button-bg);
    --btn-fg: var(--color-button-fg);
  }

  .scheme-sand {
    --bg: var(--color-sand-bg);
    --fg: var(--color-primary-text);
    --fg-muted: var(--color-secondary-text);
    --fg-rgb: {{ settings.color_text | color_extract: 'red' }}, {{ settings.color_text | color_extract: 'green' }}, {{ settings.color_text | color_extract: 'blue' }};
    --line: {{ settings.color_border | color_darken: 6 }};
    --btn-bg: var(--color-button-bg);
    --btn-fg: var(--color-button-fg);
  }

  .scheme-ink {
    --bg: var(--color-ink-bg);
    --fg: var(--color-ink-fg);
    --fg-muted: {{ settings.color_on_ink | color_mix: settings.color_ink, 65 }};
    --fg-rgb: {{ settings.color_on_ink | color_extract: 'red' }}, {{ settings.color_on_ink | color_extract: 'green' }}, {{ settings.color_on_ink | color_extract: 'blue' }};
    --line: {{ settings.color_on_ink | color_mix: settings.color_ink, 25 }};
    --btn-bg: var(--color-ink-fg);
    --btn-fg: var(--color-ink-bg);
  }

  .scheme-ivory,
  .scheme-sand,
  .scheme-ink {
    background-color: var(--bg);
    color: var(--fg);
  }
{% endstyle %}
