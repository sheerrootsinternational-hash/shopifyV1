{%- comment -%}
  Emits every per-instance CSS custom property a section needs, as one style
  attribute. This is the single place that turns section settings into visual
  output, so every section behaves identically and no section needs bespoke
  layout Liquid.

  Usage
    <div class="section ..." {% render 'section-styles', cfg: section.settings %}>

  The parameter is called `cfg` rather than `settings` on purpose: a local
  variable named `settings` would shadow the global theme settings object.

  Every property is optional. A setting the section does not declare simply
  falls through to the global default defined in snippets/theme-tokens.liquid.

  Sections with properties of their own (hero heights, for example) pass them
  as `extra`, so an element still carries exactly one style attribute:

    {% render 'section-styles', cfg: section.settings, extra: my_vars %}
{%- endcomment -%}

{%- liquid
  # ---- Spacing. Mobile falls back to the desktop value when not set. -------
  assign pad_top = cfg.padding_top
  assign pad_bottom = cfg.padding_bottom
  assign pad_top_mobile = cfg.padding_top_mobile | default: pad_top
  assign pad_bottom_mobile = cfg.padding_bottom_mobile | default: pad_bottom

  # ---- Content width ------------------------------------------------------
  assign width_value = ''
  case cfg.content_width
    when 'full'
      assign width_value = 'none'
    when 'wide'
      assign width_value = 'var(--page-width)'
    when 'contained'
      assign width_value = 'var(--page-width-contained)'
    when 'narrow'
      assign width_value = 'var(--page-width-narrow)'
    when 'custom'
      assign width_value = cfg.content_width_custom | append: 'px'
  endcase

  # ---- Typography ---------------------------------------------------------
  assign heading_scale = cfg.heading_size | divided_by: 100.0
  assign body_scale = cfg.body_size | divided_by: 100.0
-%}

style="
{%- if pad_top != blank %}--section-padding-top: {{ pad_top }}px;{% endif -%}
{%- if pad_bottom != blank %}--section-padding-bottom: {{ pad_bottom }}px;{% endif -%}
{%- if pad_top_mobile != blank %}--section-padding-top-mobile: {{ pad_top_mobile }}px;{% endif -%}
{%- if pad_bottom_mobile != blank %}--section-padding-bottom-mobile: {{ pad_bottom_mobile }}px;{% endif -%}
{%- if cfg.padding_horizontal != blank %}--section-padding-inline: {{ cfg.padding_horizontal }}px;{% endif -%}
{%- if width_value != blank %}--content-max: {{ width_value }};{% endif -%}
{%- if cfg.heading_size != blank %}--heading-scale: calc(var(--heading-scale-base) * {{ heading_scale }});{% endif -%}
{%- if cfg.body_size != blank %}--body-scale: calc(var(--body-scale-base) * {{ body_scale }});{% endif -%}
{%- if cfg.background_color != blank -%}
  --bg: {{ cfg.background_color }};
{%- endif -%}
{%- if cfg.text_color != blank -%}
  --fg: {{ cfg.text_color }};
  --fg-muted: {{ cfg.text_color }};
  --fg-rgb: {{ cfg.text_color | color_extract: 'red' }}, {{ cfg.text_color | color_extract: 'green' }}, {{ cfg.text_color | color_extract: 'blue' }};
{%- endif -%}
{%- if cfg.heading_color != blank %}--heading-color: {{ cfg.heading_color }};{% endif -%}
{%- if cfg.accent_color != blank %}--accent: {{ cfg.accent_color }};{% endif -%}
{%- if cfg.overlay_opacity != blank %}--overlay-opacity: {{ cfg.overlay_opacity | divided_by: 100.0 }};{% endif -%}
{%- if cfg.column_gap != blank %}--column-gap: {{ cfg.column_gap }}px;{% endif -%}
{%- if cfg.row_gap != blank %}--row-gap: {{ cfg.row_gap }}px;{% endif -%}
{%- if cfg.columns_desktop != blank %}--columns-desktop: {{ cfg.columns_desktop }};{% endif -%}
{%- if cfg.columns_mobile != blank %}--columns-mobile: {{ cfg.columns_mobile }};{% endif -%}
{%- if cfg.image_focal_point != blank %}--image-position: {{ cfg.image_focal_point | replace: '-', ' ' }};{% endif -%}
{{- extra -}}
"
