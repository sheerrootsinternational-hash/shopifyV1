{%- comment -%}
  Inline SVG icon.

  Usage: {% render 'icon', name: 'search' %}
         {% render 'icon', name: 'instagram', class: 'my-class' %}

  Icons are decorative by default (aria-hidden). Label the surrounding control
  instead of the icon.
{%- endcomment -%}

{%- liquid
  assign icon_class = class | default: ''
-%}

{%- case name -%}
  {%- when 'search' -%}
    <svg class="icon icon-search {{ icon_class }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <circle cx="8.75" cy="8.75" r="6"/>
      <path d="m13.2 13.2 4.3 4.3" stroke-linecap="round"/>
    </svg>
  {%- when 'close' -%}
    <svg class="icon icon-close {{ icon_class }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
      <path d="m4 4 12 12M16 4 4 16" stroke-linecap="round"/>
    </svg>
  {%- when 'menu' -%}
    <svg class="icon icon-menu {{ icon_class }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
