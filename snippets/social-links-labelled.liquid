{%- comment -%}
  Social links shown as icon + platform name, for the "Join our socials" row.
  Reads the same Theme settings as snippets/social-icons.liquid.
{%- endcomment -%}

{%- liquid
  assign has_social = false
  if settings.social_instagram_link != blank
    or settings.social_facebook_link != blank
    or settings.social_etsy_link != blank
    or settings.social_pinterest_link != blank
    or settings.social_youtube_link != blank
    or settings.social_whatsapp_link != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
  <ul class="social-labelled" role="list">
    {%- if settings.social_instagram_link != blank -%}
      <li>
        <a class="social-labelled__link" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'instagram' %}
          <span>{{ 'general.social.instagram' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_facebook_link != blank -%}
      <li>
        <a class="social-labelled__link" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'facebook' %}
          <span>{{ 'general.social.facebook' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_etsy_link != blank -%}
      <li>
        <a class="social-labelled__link" href="{{ settings.social_etsy_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'etsy' %}
          <span>{{ 'general.social.etsy' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}
      <li>
        <a class="social-labelled__link" href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'pinterest' %}
          <span>{{ 'general.social.pinterest' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
      <li>
        <a class="social-labelled__link" href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'youtube' %}
          <span>{{ 'general.social.youtube' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_whatsapp_link != blank -%}
      <li>
        <a class="social-labelled__link" href="{{ settings.social_whatsapp_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'whatsapp' %}
          <span>{{ 'general.social.whatsapp' | t }}</span>
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- else -%}
  <p class="text-muted social-labelled__empty">{{ 'sections.social.no_links' | t }}</p>
{%- endif -%}
