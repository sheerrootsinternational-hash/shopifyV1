{%- comment -%}
  Social links, driven entirely by Theme settings → Social media.
  A blank setting hides that icon everywhere.

  Accepts
    class  {String}  extra classes on the <ul>, e.g. 'social-list--large'
{%- endcomment -%}

{%- liquid
  assign has_social = false
  if settings.social_instagram_link != blank
    or settings.social_facebook_link != blank
    or settings.social_etsy_link != blank
    or settings.social_pinterest_link != blank
    or settings.social_youtube_link != blank
    or settings.social_whatsapp_link != blank
    assign has_social = true
  endif
-%}

{%- if has_social -%}
  <ul class="social-list {{ class }}" role="list">
    {%- if settings.social_instagram_link != blank -%}
      <li>
        <a class="social-list__link" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'instagram' %}
          <span class="visually-hidden">{{ 'general.social.instagram' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_facebook_link != blank -%}
      <li>
        <a class="social-list__link" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'facebook' %}
          <span class="visually-hidden">{{ 'general.social.facebook' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_etsy_link != blank -%}
      <li>
        <a class="social-list__link" href="{{ settings.social_etsy_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'etsy' %}
          <span class="visually-hidden">{{ 'general.social.etsy' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}
      <li>
        <a class="social-list__link" href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'pinterest' %}
          <span class="visually-hidden">{{ 'general.social.pinterest' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
      <li>
        <a class="social-list__link" href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'youtube' %}
          <span class="visually-hidden">{{ 'general.social.youtube' | t }}</span>
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_whatsapp_link != blank -%}
      <li>
        <a class="social-list__link" href="{{ settings.social_whatsapp_link }}" target="_blank" rel="noopener noreferrer">
          {% render 'icon', name: 'whatsapp' %}
          <span class="visually-hidden">{{ 'general.social.whatsapp' | t }}</span>
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
