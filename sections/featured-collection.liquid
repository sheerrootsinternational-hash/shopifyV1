{{ 'section-carousel.css' | asset_url | stylesheet_tag }}
{%- if section.settings.layout == 'slider' -%}
  <script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign products = collection.products
  assign product_count = collection.products_count | default: 0
  if product_count > limit
    assign product_count = limit
  endif
-%}

<div
  class="section featured-collection scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', cfg: section.settings %}
>
  <div class="page-width">
    <div class="featured-collection__header align-{{ section.settings.heading_alignment }}{% if section.settings.heading_alignment_mobile != blank %} align-mobile-{{ section.settings.heading_alignment_mobile }}{% endif %}">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_view_all and collection != blank and collection.products_count > limit -%}
        <a class="button button--link featured-collection__view-all" href="{{ collection.url }}">
          {{- 'sections.featured_collection.view_all' | t -}}
        </a>
      {%- endif -%}
    </div>

    {%- if collection == blank -%}
      <p class="featured-collection__empty text-muted">
        {{ 'sections.featured_collection.choose_collection' | t }}
      </p>
    {%- elsif product_count == 0 -%}
      <p class="featured-collection__empty text-muted">
        {{ 'sections.featured_collection.empty' | t }}
      </p>
    {%- elsif section.settings.layout == 'grid' -%}
      <ul
        class="product-grid{% if settings.animations_enabled %} scroll-reveal{% endif %}"
        role="list"
        style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-tablet: {{ section.settings.columns_desktop | at_most: 3 }}; --columns-mobile: {{ section.settings.columns_mobile }};"
      >
        {%- for product in products limit: limit -%}
          <li>
            {% render 'product-card', product: product, loading: 'lazy', image_ratio: section.settings.card_image_ratio, text_align: section.settings.card_text_alignment %}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <sr-carousel
        class="carousel"
        {% if section.settings.autoplay %}
          data-autoplay="true"
          data-autoplay-interval="{{ section.settings.autoplay_interval | times: 1000 }}"
        {% endif %}
        style="--slides-mobile: {{ section.settings.columns_mobile }}; --slides-tablet: {{ section.settings.columns_desktop | at_most: 3 }}; --slides-desktop: {{ section.settings.columns_desktop }};"
      >
        <div class="carousel__viewport">
          <ul
            class="carousel__track"
            role="list"
            tabindex="0"
            aria-label="{{ section.settings.heading | default: collection.title | escape }}"
            data-carousel-track
          >
            {%- for product in products limit: limit -%}
              <li class="carousel__slide">
                {% render 'product-card', product: product, loading: 'lazy', image_ratio: section.settings.card_image_ratio, text_align: section.settings.card_text_alignment %}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="carousel__controls" data-carousel-controls hidden>
          <button
            type="button"
            class="carousel__button"
            data-carousel-prev
            aria-label="{{ 'general.slider.previous' | t }}"
          >
            {% render 'icon', name: 'arrow-left' %}
          </button>

          {%- if section.settings.autoplay -%}
            <button
              type="button"
              class="carousel__button carousel__button--play"
              data-carousel-toggle
              data-pause-label="{{ 'general.slider.pause' | t | escape }}"
              data-play-label="{{ 'general.slider.play' | t | escape }}"
              data-paused-text="{{ 'general.slider.paused' | t | escape }}"
              aria-label="{{ 'general.slider.pause' | t }}"
            >
              <span class="carousel__pause-icon" aria-hidden="true"></span>
            </button>
          {%- endif -%}

          <button
            type="button"
            class="carousel__button"
            data-carousel-next
            aria-label="{{ 'general.slider.next' | t }}"
          >
            {% render 'icon', name: 'arrow-right' %}
          </button>
        </div>

        <p class="visually-hidden" aria-live="polite" data-carousel-status></p>
      </sr-carousel>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "shopify-section--featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products, prices, images and availability come straight from this collection — nothing is duplicated here."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "Maximum products to show",
      "default": 5
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our collection"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "label": "Heading alignment (mobile)",
      "options": [
        {
          "value": "",
          "label": "Same as desktop"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show a link to the whole collection",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Products per row on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 product"
        },
        {
          "value": "2",
          "label": "2 products"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Slider motion"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Advance the slider automatically",
      "info": "A pause button is shown, and motion is skipped for visitors who ask for reduced motion.",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Time between slides",
      "default": 5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 8,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 48
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Image shape",
      "info": "Overrides Theme settings for this section only.",
      "options": [
        {
          "value": "",
          "label": "Use theme setting"
        },
        {
          "value": "adapt",
          "label": "Use the image own shape"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card text alignment",
      "options": [
        {
          "value": "",
          "label": "Use theme setting"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
