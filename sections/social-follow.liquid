{{ 'section-social.css' | asset_url | stylesheet_tag }}

<div
  class="section social-follow scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
>
  <div class="page-width">
    <div class="social-follow__inner align-{{ section.settings.text_alignment }}{% if settings.animations_enabled %} scroll-reveal{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="h2 social-follow__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="social-follow__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.show_labels -%}
        {% render 'social-links-labelled' %}
      {%- else -%}
        <div class="social-follow__icons">
          {% render 'social-icons', class: 'social-list--large' %}
        </div>
      {%- endif -%}

      {%- if section.settings.handle != blank -%}
        <p class="social-follow__handle">{{ section.settings.handle | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul
        class="social-follow__gallery"
        role="list"
        style="--gallery-columns: {{ section.blocks.size | at_most: 6 }};"
      >
        {%- for block in section.blocks -%}
          <li class="social-follow__gallery-item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" target="_blank" rel="noopener noreferrer">
            {%- endif -%}
            <div class="media media--square">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 600, 800',
                    sizes: '(min-width: 990px) 16vw, 45vw',
                    alt: block.settings.image_alt
                }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Social",
  "tag": "section",
  "class": "shopify-section--social",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "The links themselves live in Theme settings → Social media."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our socials"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "info": "For example @sheerroots"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show platform names next to the icons",
      "default": true
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "sand"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Point this at the matching post."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social"
    }
  ]
}
{% endschema %}
