{{ 'template-page.css' | asset_url | stylesheet_tag }}

{%- paginate blog.articles by section.settings.posts_per_page -%}
  <div class="section" {% render 'section-styles', cfg: section.settings %}>
    <div class="page-width">
      <div class="section__header align-center">
        <h1 class="h1">{{ blog.title | escape }}</h1>
      </div>

      {%- if blog.articles.size == 0 -%}
        <div class="empty-state">
          <p>{{ 'blogs.general.no_articles' | t }}</p>
        </div>
      {%- else -%}
        <ul class="product-grid" role="list" style="--columns-desktop: 3; --columns-tablet: 2; --columns-mobile: 1;">
          {%- for article in blog.articles -%}
            <li>
              <article class="article-card">
                {%- if article.image -%}
                  <a href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                    <div class="media media--landscape">
                      {{
                        article.image
                        | image_url: width: 1000
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 500, 700, 1000',
                          sizes: '(min-width: 990px) 33vw, 90vw',
                          alt: article.image.alt | default: article.title
                      }}
                    </div>
                  </a>
                {%- endif -%}
                <p class="article-card__meta">{{ article.published_at | date: format: 'date' }}</p>
                <h2 class="h4">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h2>
                <p class="text-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
              </article>
            </li>
          {%- endfor -%}
        </ul>

        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "Posts per page",
      "default": 9
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 8,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 52
    }
  ],
  "enabled_on": {
    "templates": [
      "blog"
    ]
  }
}
{% endschema %}
