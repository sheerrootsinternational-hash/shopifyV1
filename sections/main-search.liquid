{{ 'template-collection.css' | asset_url | stylesheet_tag }}

<div class="section search" {% render 'section-styles', cfg: section.settings %}>
  <div class="page-width">
    <div class="search__header align-center">
      <h1 class="h1">{{ 'general.search.title' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
        <label class="visually-hidden" for="SearchPageInput">{{ 'general.search.search' | t }}</label>
        <input
          id="SearchPageInput"
          class="field__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button">{{ 'general.search.search' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="empty-state">
          <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- else -%}
        <p class="collection__count" role="status">
          {{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}
        </p>

        {%- paginate search.results by section.settings.results_per_page -%}
          <ul
            class="product-grid search__results"
            role="list"
            style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-tablet: 3; --columns-mobile: 2;"
          >
            {%- for item in search.results -%}
              <li>
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {% render 'product-card', product: item, heading_tag: 'h2', image_ratio: section.settings.card_image_ratio, text_align: section.settings.card_text_alignment %}
                  {%- else -%}
                    <article class="search__card">
                      {%- if item.image -%}
                        <div class="media media--landscape">
                          {{
                            item.image
                            | image_url: width: 800
                            | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', sizes: '(min-width: 990px) 25vw, 45vw', alt: item.title
                          }}
                        </div>
                      {%- endif -%}
                      <h2 class="h4 search__card-title">
                        <a href="{{ item.url }}">{{ item.title }}</a>
                      </h2>
                      <p class="text-muted">{{ item.content | strip_html | truncatewords: 24 }}</p>
                    </article>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "shopify-section--search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Results per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 8,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 48
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Image shape",
      "info": "Overrides Theme settings for this section only.",
      "options": [
        {
          "value": "",
          "label": "Use theme setting"
        },
        {
          "value": "adapt",
          "label": "Use the image own shape"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card text alignment",
      "options": [
        {
          "value": "",
          "label": "Use theme setting"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 52
    }
  ],
  "enabled_on": {
    "templates": [
      "search"
    ]
  }
}
{% endschema %}
