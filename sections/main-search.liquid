{{ 'template-collection.css' | asset_url | stylesheet_tag }}

<div class="section search" {% render 'section-styles', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}>
  <div class="page-width">
    <div class="search__header align-center">
      <h1 class="h1">{{ 'general.search.title' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
        <label class="visually-hidden" for="SearchPageInput">{{ 'general.search.search' | t }}</label>
        <input
          id="SearchPageInput"
          class="field__input"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button">{{ 'general.search.search' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="empty-state">
          <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- else -%}
        <p class="collection__count" role="status">
          {{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}
        </p>

        {%- paginate search.results by section.settings.results_per_page -%}
          <ul
            class="product-grid search__results"
            role="list"
            style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-tablet: 3; --columns-mobile: 2;"
          >
            {%- for item in search.results -%}
              <li>
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {% render 'product-card', product: item, heading_tag: 'h2' %}
                  {%- else -%}
                    <article class="search__card">
                      {%- if item.image -%}
                        <div class="media media--landscape">
                          {{
                            item.image
                            | image_url: width: 800
                            | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', sizes: '(min-width: 990px) 25vw, 45vw', alt: item.title
                          }}
                        </div>
                      {%- endif -%}
                      <h2 class="h4 search__card-title">
                        <a href="{{ item.url }}">{{ item.title }}</a>
                      </h2>
                      <p class="text-muted">{{ item.content | strip_html | truncatewords: 24 }}</p>
                    </article>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "shopify-section--search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Results per page",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
