{{ 'template-cart.css' | asset_url | stylesheet_tag }}

<div class="section cart" {% render 'section-styles', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}>
  <div class="page-width">
    <h1 class="cart__title h1">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">
          {{ 'cart.general.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      {%- form 'cart', cart, class: 'cart__form' -%}
        <table class="cart__table">
          <caption class="visually-hidden">{{ 'cart.general.title' | t }}</caption>
          <thead>
            <tr>
              <th scope="col" colspan="2">{{ 'cart.headings.product' | t }}</th>
              <th scope="col">{{ 'cart.headings.quantity' | t }}</th>
              <th scope="col" class="cart__cell--right">{{ 'cart.headings.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for line_item in cart.items -%}
              <tr class="cart__row">
                <td class="cart__cell cart__cell--media">
                  <a href="{{ line_item.url }}" aria-hidden="true" tabindex="-1">
                    <div class="media media--square">
                      {%- if line_item.image -%}
                        {{
                          line_item.image
                          | image_url: width: 300
                          | image_tag: loading: 'lazy', widths: '100, 150, 200, 300', sizes: '90px', alt: line_item.image.alt
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
                  </a>
                </td>

                <td class="cart__cell cart__cell--details">
                  <a class="cart__item-title" href="{{ line_item.url }}">{{ line_item.product.title | escape }}</a>

                  {%- unless line_item.product.has_only_default_variant -%}
                    <p class="cart__item-variant text-muted">{{ line_item.variant.title }}</p>
                  {%- endunless -%}

                  {%- if line_item.selling_plan_allocation -%}
                    <p class="cart__item-variant text-muted">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}

                  {%- if line_item.properties.size > 0 -%}
                    <ul class="cart__item-properties text-muted" role="list">
                      {%- for property in line_item.properties -%}
                        {%- unless property.last == blank or property.first[0] == '_' -%}
                          <li>{{ property.first }}: {{ property.last }}</li>
                        {%- endunless -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  <div class="cart__item-price">
                    {%- if line_item.original_price != line_item.final_price -%}
                      <s class="price__regular--compare">{{ line_item.original_price | money }}</s>
                      <span class="price__sale">{{ line_item.final_price | money }}</span>
                    {%- else -%}
                      {{ line_item.original_price | money }}
                    {%- endif -%}
                  </div>

                  {%- if line_item.line_level_discount_allocations.size > 0 -%}
                    <ul class="cart__discounts" role="list">
                      {%- for allocation in line_item.line_level_discount_allocations -%}
                        <li>{{ allocation.discount_application.title }} (-{{ allocation.amount | money }})</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </td>

                <td class="cart__cell cart__cell--quantity">
                  <label class="visually-hidden" for="CartQuantity-{{ forloop.index }}">
                    {{ 'cart.headings.quantity' | t }}
                  </label>
                  <input
                    id="CartQuantity-{{ forloop.index }}"
                    class="field__input cart__quantity"
                    type="number"
                    name="updates[]"
                    value="{{ line_item.quantity }}"
                    min="0"
                    step="1"
                    inputmode="numeric"
                  >
                  <a class="cart__remove" href="{{ line_item.url_to_remove }}">
                    {{- 'cart.general.remove' | t -}}
                    <span class="visually-hidden">&nbsp;{{ line_item.product.title | escape }}</span>
                  </a>
                </td>

                <td class="cart__cell cart__cell--right cart__cell--total">
                  {{ line_item.line_price | money }}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart__footer">
          {%- if section.settings.show_note -%}
            <div class="cart__note field">
              <label class="field__label" for="CartNote">{{ 'cart.general.note' | t }}</label>
              <textarea id="CartNote" class="field__input" name="note" rows="3">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart__summary">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="cart__discounts" role="list">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>{{ discount.title }} (-{{ discount.total_allocated_amount | money }})</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <div class="cart__subtotal">
              <span>{{ 'cart.general.subtotal' | t }}</span>
              <span class="cart__subtotal-price">{{ cart.total_price | money_with_currency }}</span>
            </div>

            <p class="cart__tax-note text-muted">{{ 'cart.general.tax_note' | t }}</p>

            <div class="cart__actions">
              <button type="submit" name="update" class="button button--secondary button--full">
                {{ 'cart.general.update' | t }}
              </button>
              <button type="submit" name="checkout" class="button button--full">
                {{ 'cart.general.checkout' | t }}
              </button>
            </div>
          </div>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "shopify-section--cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show an order notes box",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}
