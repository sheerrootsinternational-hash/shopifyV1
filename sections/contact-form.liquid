{{ 'template-page.css' | asset_url | stylesheet_tag }}

<div
  class="section contact-form-section scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
>
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section__header align-{{ section.settings.text_alignment }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="subheading rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Shopify's own contact form handles delivery, spam protection and the
      success redirect — no external backend or third-party form service.
    {%- endcomment -%}
    {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="form__message form__message--success" role="status" tabindex="-1" autofocus>
          {{ 'contact.form.post_success' | t }}
        </div>
      {%- elsif form.errors -%}
        <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
          <div>
            <p>{{ 'contact.form.error_heading' | t }}</p>
            <ul role="list">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

      <div class="contact-form__grid">
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.form.name' | t }}</label>
          <input
            id="ContactName"
            class="field__input"
            type="text"
            name="contact[{{ 'contact.form.name' | t }}]"
            value="{{ form.name | default: customer.name | escape }}"
            autocomplete="name"
          >
        </div>

        <div class="field">
          <label class="field__label" for="ContactEmail">
            {{ 'contact.form.email' | t }}
            <span aria-hidden="true">*</span>
          </label>
          <input
            id="ContactEmail"
            class="field__input"
            type="email"
            name="contact[email]"
            value="{{ form.email | default: customer.email | escape }}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <div class="field contact-form__field--full">
          <label class="field__label" for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
          <input
            id="ContactPhone"
            class="field__input"
            type="tel"
            name="contact[{{ 'contact.form.phone' | t }}]"
            value="{{ form.phone | escape }}"
            autocomplete="tel"
          >
        </div>

        <div class="field contact-form__field--full">
          <label class="field__label" for="ContactBody">{{ 'contact.form.message' | t }}</label>
          <textarea id="ContactBody" class="field__input" name="contact[body]" rows="6">
            {{- form.body -}}
          </textarea>
        </div>
      </div>

      <div class="section__actions align-{{ section.settings.text_alignment }}">
        <button type="submit" class="button">{{ 'contact.form.send' | t }}</button>
      </div>

      {%- if section.settings.privacy_note != blank -%}
        <div class="contact-form__note text-muted rte">{{ section.settings.privacy_note }}</div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "shopify-section--contact-form",
  "settings": [
    {
      "type": "paragraph",
      "content": "Submissions arrive at the sender email set in Shopify admin → Settings → Store details."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reach out"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "richtext",
      "id": "privacy_note",
      "label": "Note under the form"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
