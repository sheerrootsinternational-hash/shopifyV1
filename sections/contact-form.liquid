{{ 'template-page.css' | asset_url | stylesheet_tag }}

<div
  class="section contact-form-section scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', cfg: section.settings %}
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section__header align-{{ section.settings.text_alignment }}{% if section.settings.text_alignment_mobile != blank %} align-mobile-{{ section.settings.text_alignment_mobile }}{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="subheading rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Shopify's own contact form handles delivery, spam protection and the
      success redirect — no external backend or third-party form service.
    {%- endcomment -%}
    {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <div class="form__message form__message--success" role="status" tabindex="-1" autofocus>
          {{ 'contact.form.post_success' | t }}
        </div>
      {%- elsif form.errors -%}
        <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
          <div>
            <p>{{ 'contact.form.error_heading' | t }}</p>
            <ul role="list">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

      <div class="contact-form__grid">
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.form.name' | t }}</label>
          <input
            id="ContactName"
            class="field__input"
            type="text"
            name="contact[{{ 'contact.form.name' | t }}]"
            value="{{ form.name | default: customer.name | escape }}"
            autocomplete="name"
          >
        </div>

        <div class="field">
          <label class="field__label" for="ContactEmail">
            {{ 'contact.form.email' | t }}
            <span aria-hidden="true">*</span>
          </label>
          <input
            id="ContactEmail"
            class="field__input"
            type="email"
            name="contact[email]"
            value="{{ form.email | default: customer.email | escape }}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            {% if form.errors contains 'email' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <div class="field contact-form__field--full">
          <label class="field__label" for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
          <input
            id="ContactPhone"
            class="field__input"
            type="tel"
            name="contact[{{ 'contact.form.phone' | t }}]"
            value="{{ form.phone | escape }}"
            autocomplete="tel"
          >
        </div>

        <div class="field contact-form__field--full">
          <label class="field__label" for="ContactBody">{{ 'contact.form.message' | t }}</label>
          <textarea id="ContactBody" class="field__input" name="contact[body]" rows="6">
            {{- form.body -}}
          </textarea>
        </div>
      </div>

      <div class="section__actions align-{{ section.settings.text_alignment }}{% if section.settings.text_alignment_mobile != blank %} align-mobile-{{ section.settings.text_alignment_mobile }}{% endif %}">
        <button type="submit" class="button">{{ 'contact.form.send' | t }}</button>
      </div>

      {%- if section.settings.privacy_note != blank -%}
        <div class="contact-form__note text-muted rte">{{ section.settings.privacy_note }}</div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "shopify-section--contact-form",
  "settings": [
    {
      "type": "paragraph",
      "content": "Submissions arrive at the sender email set in Shopify admin → Settings → Store details."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reach out"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "richtext",
      "id": "privacy_note",
      "label": "Note under the form"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Alignment (mobile)",
      "options": [
        {
          "value": "",
          "label": "Same as desktop"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
