{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_content = false
  if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank
    assign has_content = true
  endif

  assign heading_tag = 'h2'
  if section.settings.heading_is_page_title
    assign heading_tag = 'h1'
  endif

  # Desktop height. "adapt" lets the image decide, so the whole composition
  # stays visible rather than being cropped to a viewport fraction.
  case section.settings.height
    when 'adapt'
      assign height_desktop = 'auto'
    when 'small'
      assign height_desktop = '40vh'
    when 'medium'
      assign height_desktop = '58vh'
    when 'large'
      assign height_desktop = '76vh'
    when 'full'
      assign height_desktop = '100svh'
    when 'custom'
      assign height_desktop = section.settings.height_custom | append: 'px'
  endcase

  # Mobile height, defaulting to a sensible smaller preset rather than reusing
  # a desktop viewport percentage that would be far too short on a phone.
  assign mobile_choice = section.settings.height_mobile | default: 'medium'
  case mobile_choice
    when 'adapt'
      assign height_mobile = 'auto'
    when 'small'
      assign height_mobile = '34rem'
    when 'medium'
      assign height_mobile = '46rem'
    when 'large'
      assign height_mobile = '60rem'
    when 'full'
      assign height_mobile = '100svh'
    when 'custom'
      assign height_mobile = section.settings.height_custom_mobile | append: 'px'
  endcase
-%}

{%- capture hero_vars -%}
  --hero-height: {{ height_desktop }};--hero-height-mobile: {{ height_mobile }};
{%- endcapture -%}

<section
  class="hero hero--text-{{ section.settings.text_position }} scheme-{{ section.settings.color_scheme }}{% if section.settings.height == 'adapt' %} hero--adapt{% endif %}{% if mobile_choice == 'adapt' %} hero--adapt-mobile{% endif %}"
  {% render 'section-styles', cfg: section.settings, extra: hero_vars %}
>
  <div class="hero__media">
    {% render 'banner-image',
      desktop_image: section.settings.desktop_image,
      mobile_image: section.settings.mobile_image,
      alt: section.settings.image_alt,
      loading: 'eager',
      fetchpriority: 'high',
      sizes: '100vw',
      class: 'hero__image',
      placeholder: 'lifestyle-1'
    %}
    {%- if section.settings.overlay_opacity > 0 -%}
      <span class="hero__overlay" aria-hidden="true"></span>
    {%- endif -%}
  </div>

  {%- if has_content -%}
    <div class="hero__content-wrap page-width">
      <div class="hero__content align-{{ section.settings.text_alignment }}{% if section.settings.text_alignment_mobile != blank %} align-mobile-{{ section.settings.text_alignment_mobile }}{% endif %} hero__content--{{ section.settings.text_style }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="hero__heading h0">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="section__actions">
            <a
              class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% endif %}"
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                href="#" role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_label | escape -}}
            </a>
            {%- if section.settings.button_label_2 != blank -%}
              <a
                class="button button--secondary"
                {% if section.settings.button_link_2 != blank %}
                  href="{{ section.settings.button_link_2 }}"
                {% else %}
                  href="#" role="link" aria-disabled="true"
                {% endif %}
              >
                {{- section.settings.button_label_2 | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
