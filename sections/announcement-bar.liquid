{{ 'section-announcement.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_messages = false
  for block in section.blocks
    if block.settings.text != blank
      assign has_messages = true
      break
    endif
  endfor
-%}

{%- if has_messages -%}
  <div
    class="announcement scheme-{{ section.settings.color_scheme }} align-{{ section.settings.text_alignment | default: 'center' }}"
    role="region"
    aria-label="{{ 'sections.announcements.announcement' | t }}"
    {% render 'section-styles', cfg: section.settings %}
  >
    {%- if section.settings.scrolling -%}
      {%- comment -%}
        A pure-CSS marquee. The track is duplicated so the animation can loop
        seamlessly; the duplicate is hidden from assistive technology.
      {%- endcomment -%}
      <div class="announcement__marquee" style="--marquee-duration: {{ section.settings.speed }}s;">
        {%- for i in (1..2) -%}
          <div class="announcement__track" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <span class="announcement__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </span>
                <span class="announcement__separator" aria-hidden="true">{{ section.settings.separator }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="announcement__static page-width">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <span class="announcement__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section--announcement",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "scrolling",
      "label": "Scroll the text continuously",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Time for one full loop",
      "info": "Higher is slower. Only applies when scrolling is on.",
      "default": 45
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "info": "Shown between messages while scrolling.",
      "default": "✳"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "info": "Applies when the text is not scrolling.",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Alignment (mobile)",
      "options": [
        {
          "value": "",
          "label": "Same as desktop"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ink"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Every piece. A story. India."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
