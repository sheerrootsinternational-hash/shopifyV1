{{ 'section-announcement.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_messages = false
  for block in section.blocks
    if block.settings.text != blank
      assign has_messages = true
      break
    endif
  endfor
-%}

{%- if has_messages -%}
  <div
    class="announcement scheme-{{ section.settings.color_scheme }}"
    role="region"
    aria-label="{{ 'sections.announcements.announcement' | t }}"
  >
    {%- if section.settings.scrolling -%}
      {%- comment -%}
        A pure-CSS marquee. The track is duplicated so the animation can loop
        seamlessly; the duplicate is hidden from assistive technology.
      {%- endcomment -%}
      <div class="announcement__marquee" style="--marquee-duration: {{ section.settings.speed }}s;">
        {%- for i in (1..2) -%}
          <div class="announcement__track" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <span class="announcement__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                  {%- else -%}
                    {{ block.settings.text }}
                  {%- endif -%}
                </span>
                <span class="announcement__separator" aria-hidden="true">{{ section.settings.separator }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="announcement__static page-width">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <span class="announcement__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section--announcement",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    },
    {
      "type": "checkbox",
      "id": "scrolling",
      "label": "Scroll the text continuously",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Time for one full loop",
      "info": "Higher is slower. Only applies when scrolling is on.",
      "default": 45
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "info": "Shown between messages while scrolling.",
      "default": "✳"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Every piece. A story. India."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "announcement" }]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
