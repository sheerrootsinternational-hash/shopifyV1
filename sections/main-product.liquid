{{ 'template-product.css' | asset_url | stylesheet_tag }}
{{ 'section-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'read-more.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
-%}

<section class="section product" {% render 'section-styles', cfg: section.settings %}>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs' %}
    {%- endif -%}

    <sr-product class="product__grid" data-url="{{ product.url }}" data-section-id="{{ section.id }}">
      <div class="product__media" data-product-media>
        {%- if product.media.size > 0 -%}
          <sr-gallery
            class="product-gallery product-gallery--thumbs-{{ section.settings.thumbnail_position }}{% if section.settings.enable_zoom %} product-gallery--zoom{% endif %}"
            style="--thumb-size: {{ section.settings.thumbnail_size }}px; --thumb-gap: {{ section.settings.thumbnail_gap }}px;"
          >
            <div class="product-gallery__stage">
              <ul
                class="product-gallery__track"
                role="list"
                tabindex="0"
                aria-label="{{ 'products.product.gallery' | t }}"
                data-gallery-track
              >
                {%- for media in product.media -%}
                  {%- liquid
                    # Only the first image is worth fetching eagerly; the rest
                    # load as the visitor reaches them.
                    assign media_loading = 'lazy'
                    assign media_priority = 'auto'
                    if forloop.first
                      assign media_loading = 'eager'
                      assign media_priority = 'high'
                    endif
                  -%}
                  <li
                    class="product-gallery__slide{% if media.id == current_variant.featured_media.id %} is-active{% endif %}"
                    data-media-id="{{ media.id }}"
                  >
                    {%- case media.media_type -%}
                      {%- when 'image' -%}
                        <div class="media media--{{ section.settings.image_ratio }}">
                          {{
                            media
                            | image_url: width: 1600
                            | image_tag:
                              loading: media_loading,
                              fetchpriority: media_priority,
                              widths: '400, 600, 800, 1000, 1200, 1400, 1600',
                              sizes: '(min-width: 990px) 55vw, 100vw',
                              alt: media.alt,
                              class: 'product-gallery__image'
                          }}
                        </div>
                      {%- when 'video' -%}
                        <div class="media media--{{ section.settings.image_ratio }}">
                          {{ media | video_tag: controls: true, preload: 'metadata', image_size: '1200x' }}
                        </div>
                      {%- when 'external_video' -%}
                        <div class="media media--landscape">
                          {{ media | external_video_tag: loading: 'lazy' }}
                        </div>
                      {%- when 'model' -%}
                        <div class="media media--{{ section.settings.image_ratio }}">
                          {{ media | model_viewer_tag }}
                        </div>
                    {%- endcase -%}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if section.settings.show_arrows and product.media.size > 1 -%}
                <button
                  type="button"
                  class="product-gallery__arrow product-gallery__arrow--prev"
                  data-gallery-prev
                  aria-label="{{ 'products.product.previous_image' | t }}"
                >
                  {% render 'icon', name: 'arrow-left' %}
                </button>
                <button
                  type="button"
                  class="product-gallery__arrow product-gallery__arrow--next"
                  data-gallery-next
                  aria-label="{{ 'products.product.next_image' | t }}"
                >
                  {% render 'icon', name: 'arrow-right' %}
                </button>
              {%- endif -%}

              <p
                class="visually-hidden"
                aria-live="polite"
                data-gallery-status
                data-template="{{ 'products.product.image_counter' | t: index: '[index]', total: '[total]' | escape }}"
              ></p>
            </div>

            {%- if section.settings.show_thumbnails and product.media.size > 1 -%}
              <ul class="product-gallery__thumbs" role="list" data-gallery-thumbs>
                {%- for media in product.media -%}
                  <li>
                    <button
                      type="button"
                      class="product-gallery__thumb{% if media.id == current_variant.featured_media.id %} is-active{% endif %}"
                      data-gallery-thumb
                      data-media-id="{{ media.id }}"
                      aria-label="{{ 'products.product.show_image' | t: index: forloop.index, total: product.media.size }}"
                    >
                      {{
                        media.preview_image
                        | image_url: width: 300
                        | image_tag:
                          loading: 'lazy',
                          widths: '60, 90, 120, 180, 240, 300',
                          sizes: '120px',
                          alt: ''
                      }}
                      {%- unless media.media_type == 'image' -%}
                        <span class="product-gallery__thumb-badge" aria-hidden="true">
                          {% render 'icon', name: 'play' %}
                        </span>
                      {%- endunless -%}
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </sr-gallery>
        {%- else -%}
          <div class="media media--square">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info" data-product-info>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="product__vendor eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div class="product__price" data-product-price {{ block.shopify_attributes }}>
                {% render 'price', product: product, target: current_variant %}
                {%- if block.settings.show_tax_note -%}
                  <p class="product__tax text-muted">{{ 'products.product.tax_note_html' | t }}</p>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- comment -%}
                Three presentations of the same, untouched product description.
                Nothing is truncated server-side — only the visible height is
                controlled, so the full text is always in the page.
              {%- endcomment -%}
              {%- if product.description != blank -%}
                {%- case block.settings.display_mode -%}
                  {%- when 'collapsed' -%}
                    <details class="accordion__item product__accordion" {{ block.shopify_attributes }}>
                      <summary class="accordion__summary">
                        <span>{{ block.settings.heading | default: 'Description' | escape }}</span>
                        {% render 'icon', name: 'caret' %}
                      </summary>
                      <div class="accordion__content rte">{{ product.description }}</div>
                    </details>

                  {%- when 'read_more' -%}
                    <div class="product__description" {{ block.shopify_attributes }}>
                      {%- if block.settings.heading != blank -%}
                        <h2 class="product__description-heading">{{ block.settings.heading | escape }}</h2>
                      {%- endif -%}
                      <sr-read-more
                        class="read-more"
                        style="--read-more-height: {{ block.settings.preview_height }}px;"
                        data-more-label="{{ block.settings.read_more_label | default: 'Read more' | escape }}"
                        data-less-label="{{ block.settings.read_less_label | default: 'Read less' | escape }}"
                      >
                        <div class="read-more__content rte" data-read-more-content>
                          {{ product.description }}
                        </div>
                      </sr-read-more>
                    </div>

                  {%- else -%}
                    <div class="product__description" {{ block.shopify_attributes }}>
                      {%- if block.settings.heading != blank -%}
                        <h2 class="product__description-heading">{{ block.settings.heading | escape }}</h2>
                      {%- endif -%}
                      <div class="rte">{{ product.description }}</div>
                    </div>
                {%- endcase -%}
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="product__custom-text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}

            {%- when 'strapline' -%}
              {%- if block.settings.text != blank -%}
                <p class="product__strapline" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {% render 'variant-picker', product: product, block: block %}

            {%- when 'quantity' -%}
              <div class="product__quantity" {{ block.shopify_attributes }}>
                <label class="field__label" for="Quantity-{{ section.id }}">
                  {{ 'products.product.quantity' | t }}
                </label>
                <input
                  id="Quantity-{{ section.id }}"
                  class="field__input product__quantity-input"
                  type="number"
                  name="quantity"
                  form="{{ product_form_id }}"
                  value="1"
                  min="1"
                  step="1"
                  inputmode="numeric"
                >
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
                  <button
                    type="submit"
                    name="add"
                    class="button button--full product__submit"
                    data-add-button
                    {% if current_variant.available == false %}disabled{% endif %}
                  >
                    <span data-add-button-text>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'collapsible_row' -%}
              {%- if block.settings.heading != blank -%}
                <details class="accordion__item product__accordion" {{ block.shopify_attributes }}>
                  <summary class="accordion__summary">
                    {{ block.settings.heading | escape }}
                    {% render 'icon', name: 'caret' %}
                  </summary>
                  <div class="accordion__content rte">
                    {{ block.settings.content }}
                    {%- if block.settings.page != blank -%}
                      {{ pages[block.settings.page].content }}
                    {%- endif -%}
                  </div>
                </details>
              {%- endif -%}

      {%- when 'share' -%}
        <div class="product__share" {{ block.shopify_attributes }}>
          <span class="field__label">{{ 'products.product.share' | t }}</span>
          {%- assign product_share_url = shop.url | append: product.url -%}
          {%- assign product_share_text = product.title | append: ' - ' | append: product_share_url -%}
          <ul class="pill-list" role="list">

          {%- comment -%} Facebook {%- endcomment -%}
            <li>
              <a
                class="pill"
                href="https://www.facebook.com/sharer/sharer.php?u={{ product_share_url | url_encode }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Share {{ product.title | escape }} on Facebook"
              >
                Facebook
              </a>
            </li>

            {%- comment -%} WhatsApp {%- endcomment -%}
            <li>
              <a
                class="pill"
                href="https://wa.me/?text={{ product_share_text | url_encode }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Share {{ product.title | escape }} on WhatsApp"
              >
                WhatsApp
              </a>
            </li>

            {%- comment -%} Instagram profile {%- endcomment -%}
            <li>
              <a
                class="pill"
                href="https://www.instagram.com/sheerroots_india/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Visit Sheer Roots on Instagram"
              >
                Instagram
              </a>
            </li>

            {%- comment -%} Pinterest {%- endcomment -%}
            <li>
              <a
                class="pill"
                href="https://pinterest.com/pin/create/button/?url={{ product_share_url | url_encode }}&media={{ product.featured_media | image_url: width: 1200 | url_encode }}&description={{ product.title | url_encode }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Save {{ product.title | escape }} on Pinterest"
              >
                Pinterest
              </a>
            </li>

            {%- comment -%} Email {%- endcomment -%}
            <li>
              <a
                class="pill"
                href="mailto:?subject={{ product.title | url_encode }}&body={{ product_share_url | url_encode }}"
                aria-label="Share {{ product.title | escape }} by email"
              >
                Email
              </a>
            </li>
          </ul>
        </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- comment -%}
        Variant data for the picker. Rendering it as JSON keeps the enhancement
        entirely client-side — no extra request when switching options.
      {%- endcomment -%}
      <script type="application/json" data-variant-data>
        {
          "moneyFormat": {{ shop.money_format | json }},
          "variants": [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "options": {{ variant.options | json }},
                "available": {{ variant.available }},
                "price": {{ variant.price }},
                "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
                "featuredMediaId": {{ variant.featured_media.id | default: 0 }},
                "url": {{ variant.url | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          "strings": {
            "addToCart": {{ 'products.product.add_to_cart' | t | json }},
            "soldOut": {{ 'products.product.sold_out' | t | json }},
            "unavailable": {{ 'products.product.unavailable' | t | json }}
          }
        }
      </script>
    </sr-product>
  </div>
</section>

{% render 'product-structured-data', product: product %}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "shopify-section--main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "A fixed shape keeps the main image from jumping as you move between media.",
      "options": [
        {
          "value": "adapt",
          "label": "Use the image own shape"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "Thumbnail position",
      "info": "Thumbnails always sit below the image on mobile.",
      "options": [
        {
          "value": "below",
          "label": "Below the image"
        },
        {
          "value": "left",
          "label": "Left of the image"
        }
      ],
      "default": "below"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show thumbnails",
      "default": true
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "min": 56,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Thumbnail size",
      "default": 88
    },
    {
      "type": "range",
      "id": "thumbnail_gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Thumbnail gap",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show previous / next arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Zoom the image on hover",
      "info": "Desktop only.",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Show tax and shipping note",
          "default": true
        }
      ]
    },
    {
      "type": "strapline",
      "name": "Tagline",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tagline",
          "info": "Connect this to a product metafield with the dynamic source button to vary it per product."
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "Quantity",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show express checkout buttons",
          "info": "Shows the payment options a customer has already set up, such as Shop Pay or UPI.",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "display_mode",
          "label": "Description display",
          "options": [
            {
              "value": "full",
              "label": "Full description"
            },
            {
              "value": "read_more",
              "label": "Read more"
            },
            {
              "value": "collapsed",
              "label": "Collapsed"
            }
          ],
          "info": "Read more shows a preview with a toggle. Collapsed hides it behind a heading. Neither shortens the description itself.",
          "default": "read_more"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Required for the Collapsed style.",
          "default": "Description"
        },
        {
          "type": "range",
          "id": "preview_height",
          "min": 80,
          "max": 600,
          "step": 20,
          "unit": "px",
          "label": "Preview height",
          "info": "How much of the description is visible before Read more.",
          "default": 200
        },
        {
          "type": "text",
          "id": "read_more_label",
          "label": "Read more label",
          "default": "Read more"
        },
        {
          "type": "text",
          "id": "read_less_label",
          "label": "Read less label",
          "default": "Read less"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "collapsible_row",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Care instructions"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Or show a page's content"
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1
    }
  ]
}
{% endschema %}
