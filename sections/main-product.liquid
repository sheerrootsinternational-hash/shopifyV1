{{ 'template-product.css' | asset_url | stylesheet_tag }}
{{ 'section-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
-%}

<section class="section product" {% render 'section-styles', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs' %}
    {%- endif -%}

    <sr-product class="product__grid" data-url="{{ product.url }}" data-section-id="{{ section.id }}">
      <div class="product__media" data-product-media>
        {%- if product.media.size > 0 -%}
          <ul class="product__media-list" role="list" data-media-list>
            {%- for media in product.media -%}
              {%- liquid
                assign media_loading = 'lazy'
                if forloop.first
                  assign media_loading = 'eager'
                endif
              -%}
              <li
                class="product__media-item{% if media.id == current_variant.featured_media.id %} is-active{% endif %}"
                data-media-id="{{ media.id }}"
              >
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <div class="media media--adapt">
                      {{
                        media
                        | image_url: width: 1600
                        | image_tag:
                          loading: media_loading,
                          widths: '400, 600, 800, 1000, 1200, 1400, 1600',
                          sizes: '(min-width: 990px) 55vw, 100vw',
                          alt: media.alt
                      }}
                    </div>
                  {%- when 'video' -%}
                    <div class="media media--adapt">
                      {{ media | video_tag: controls: true, preload: 'metadata', image_size: '1200x' }}
                    </div>
                  {%- when 'external_video' -%}
                    <div class="media media--landscape">
                      {{ media | external_video_tag: loading: 'lazy' }}
                    </div>
                  {%- when 'model' -%}
                    <div class="media media--adapt">
                      {{ media | model_viewer_tag }}
                    </div>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="media media--square">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info" data-product-info>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="product__vendor eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div class="product__price" data-product-price {{ block.shopify_attributes }}>
                {% render 'price', product: product, target: current_variant %}
                {%- if block.settings.show_tax_note -%}
                  <p class="product__tax text-muted">{{ 'products.product.tax_note_html' | t }}</p>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="product__custom-text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}

            {%- when 'strapline' -%}
              {%- if block.settings.text != blank -%}
                <p class="product__strapline" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {% render 'variant-picker', product: product, block: block %}

            {%- when 'quantity' -%}
              <div class="product__quantity" {{ block.shopify_attributes }}>
                <label class="field__label" for="Quantity-{{ section.id }}">
                  {{ 'products.product.quantity' | t }}
                </label>
                <input
                  id="Quantity-{{ section.id }}"
                  class="field__input product__quantity-input"
                  type="number"
                  name="quantity"
                  form="{{ product_form_id }}"
                  value="1"
                  min="1"
                  step="1"
                  inputmode="numeric"
                >
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
                  <button
                    type="submit"
                    name="add"
                    class="button button--full product__submit"
                    data-add-button
                    {% if current_variant.available == false %}disabled{% endif %}
                  >
                    <span data-add-button-text>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'collapsible_row' -%}
              {%- if block.settings.heading != blank -%}
                <details class="accordion__item product__accordion" {{ block.shopify_attributes }}>
                  <summary class="accordion__summary">
                    {{ block.settings.heading | escape }}
                    {% render 'icon', name: 'caret' %}
                  </summary>
                  <div class="accordion__content rte">
                    {{ block.settings.content }}
                    {%- if block.settings.page != blank -%}
                      {{ pages[block.settings.page].content }}
                    {%- endif -%}
                  </div>
                </details>
              {%- endif -%}

            {%- when 'share' -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                <span class="field__label">{{ 'products.product.share' | t }}</span>
                <ul class="pill-list" role="list">
                  <li>
                    <a
                      class="pill"
                      href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ product.url }}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {{- 'general.social.facebook' | t -}}
                    </a>
                  </li>
                  <li>
                    <a
                      class="pill"
                      href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}&media={{ product.featured_media | image_url: width: 1200 }}&description={{ product.title | url_encode }}"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {{- 'general.social.pinterest' | t -}}
                    </a>
                  </li>
                  <li>
                    <a class="pill" href="mailto:?subject={{ product.title | url_encode }}&body={{ shop.url }}{{ product.url }}">
                      {{- 'general.social.email' | t -}}
                    </a>
                  </li>
                </ul>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      {%- comment -%}
        Variant data for the picker. Rendering it as JSON keeps the enhancement
        entirely client-side — no extra request when switching options.
      {%- endcomment -%}
      <script type="application/json" data-variant-data>
        {
          "moneyFormat": {{ shop.money_format | json }},
          "variants": [
            {%- for variant in product.variants -%}
              {
                "id": {{ variant.id }},
                "options": {{ variant.options | json }},
                "available": {{ variant.available }},
                "price": {{ variant.price }},
                "compareAtPrice": {{ variant.compare_at_price | default: 0 }},
                "featuredMediaId": {{ variant.featured_media.id | default: 0 }},
                "url": {{ variant.url | json }}
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ],
          "strings": {
            "addToCart": {{ 'products.product.add_to_cart' | t | json }},
            "soldOut": {{ 'products.product.sold_out' | t | json }},
            "unavailable": {{ 'products.product.unavailable' | t | json }}
          }
        }
      </script>
    </sr-product>
  </div>
</section>

{% render 'product-structured-data', product: product %}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "shopify-section--main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Show tax and shipping note",
          "default": true
        }
      ]
    },
    {
      "type": "strapline",
      "name": "Tagline",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tagline",
          "info": "Connect this to a product metafield with the dynamic source button to vary it per product."
        }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "quantity", "name": "Quantity", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show express checkout buttons",
          "info": "Shows the payment options a customer has already set up, such as Shop Pay or UPI.",
          "default": true
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "collapsible_row",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Care instructions"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Or show a page's content"
        }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1 }
  ]
}
{% endschema %}
