{{ 'template-collection.css' | asset_url | stylesheet_tag }}

<div
  class="section scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
>
  <div class="page-width">
    <div class="section__header align-center">
      <h1 class="h1">{{ section.settings.heading | default: page_title | escape }}</h1>
    </div>

    <ul
      class="product-grid"
      role="list"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-tablet: 3; --columns-mobile: {{ section.settings.columns_mobile }};"
    >
      {%- for list_collection in collections -%}
        <li>
          <div class="card card--align-center" style="--card-align: center;">
            <div class="card__media">
              <div class="media media--square">
                {%- if list_collection.image -%}
                  {{
                    list_collection.image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 25vw, 45vw',
                      alt: list_collection.image.alt | default: list_collection.title
                  }}
                {%- elsif list_collection.products.first.featured_media -%}
                  {{
                    list_collection.products.first.featured_media
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 25vw, 45vw',
                      alt: list_collection.title
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
            <div class="card__content">
              <h2 class="card__title">
                <a href="{{ list_collection.url }}">{{ list_collection.title | escape }}</a>
              </h2>
              <p class="text-muted">
                {{ 'collections.general.product_count' | t: count: list_collection.products_count }}
              </p>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ivory"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "enabled_on": {
    "templates": ["list-collections"]
  }
}
{% endschema %}
