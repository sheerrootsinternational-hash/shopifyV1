{{ 'template-collection.css' | asset_url | stylesheet_tag }}

<div
  class="section scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', cfg: section.settings %}
>
  <div class="page-width">
    <div class="section__header align-center">
      <h1 class="h1">{{ section.settings.heading | default: page_title | escape }}</h1>
    </div>

    <ul
      class="product-grid"
      role="list"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-tablet: 3; --columns-mobile: {{ section.settings.columns_mobile }};"
    >
      {%- for list_collection in collections -%}
        <li>
          <div class="card card--align-center" style="--card-align: center;">
            <div class="card__media">
              <div class="media media--square">
                {%- if list_collection.image -%}
                  {{
                    list_collection.image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 25vw, 45vw',
                      alt: list_collection.image.alt | default: list_collection.title
                  }}
                {%- elsif list_collection.products.first.featured_media -%}
                  {{
                    list_collection.products.first.featured_media
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 25vw, 45vw',
                      alt: list_collection.title
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
            <div class="card__content">
              <h2 class="card__title">
                <a href="{{ list_collection.url }}">{{ list_collection.title | escape }}</a>
              </h2>
              <p class="text-muted">
                {{ 'collections.general.product_count' | t: count: list_collection.products_count }}
              </p>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 8,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Row gap",
      "default": 48
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 52
    }
  ],
  "enabled_on": {
    "templates": [
      "list-collections"
    ]
  }
}
{% endschema %}
