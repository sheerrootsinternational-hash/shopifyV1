{{ 'section-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  # Drawn from the product's own collection so no merchant maintenance and no
  # extra JavaScript request are needed.
  assign source = section.settings.collection | default: product.collections.first
  assign limit = section.settings.products_to_show | plus: 1
-%}

{%- if source != blank -%}
  {%- assign shown = 0 -%}
  <div
    class="section related-products scheme-{{ section.settings.color_scheme }}"
    {% render 'section-styles', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section__header align-center">
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}

      <ul
        class="product-grid"
        role="list"
        style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-tablet: {{ section.settings.columns_desktop | at_most: 3 }}; --columns-mobile: 2;"
      >
        {%- for item in source.products limit: limit -%}
          {%- if item.id != product.id and shown < section.settings.products_to_show -%}
            {%- assign shown = shown | plus: 1 -%}
            <li>
              {% render 'product-card', product: item %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "class": "shopify-section--related",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use the collection the product belongs to."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "sand"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
