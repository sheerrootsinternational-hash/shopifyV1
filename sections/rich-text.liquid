{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

<div
  class="section rich-text scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', cfg: section.settings %}
>
  <div class="page-width">
    <div class="rich-text__inner align-{{ section.settings.text_alignment }}{% if section.settings.text_alignment_mobile != blank %} align-mobile-{{ section.settings.text_alignment_mobile }}{% endif %}{% if settings.animations_enabled %} scroll-reveal{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>

          {%- when 'heading' -%}
            <{{ block.settings.heading_tag }}
              class="rich-text__heading {{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.heading | escape -}}
            </{{ block.settings.heading_tag }}>

          {%- when 'text' -%}
            <div class="rich-text__text rte {{ block.settings.text_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'quote' -%}
            <blockquote class="rich-text__quote pull-quote" {{ block.shopify_attributes }}>
              {%- if block.settings.show_icon -%}
                {% render 'icon', name: 'quote', class: 'rich-text__quote-icon' %}
              {%- endif -%}
              <p>{{ block.settings.quote | escape }}</p>
              {%- if block.settings.attribution != blank -%}
                <cite class="rich-text__cite">{{ block.settings.attribution | escape }}</cite>
              {%- endif -%}
            </blockquote>

          {%- when 'rule' -%}
            <hr class="rule" {{ block.shopify_attributes }}>

          {%- when 'button' -%}
            <div class="section__actions" {{ block.shopify_attributes }}>
              <a
                class="button{% if block.settings.style == 'secondary' %} button--secondary{% elsif block.settings.style == 'link' %} button--link{% endif %}"
                {% if block.settings.link != blank %}
                  href="{{ block.settings.link }}"
                {% else %}
                  href="#" role="link" aria-disabled="true"
                {% endif %}
              >
                {{- block.settings.label | escape -}}
              </a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "shopify-section--rich-text",
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text alignment (mobile)",
      "options": [
        {
          "value": "",
          "label": "Same as desktop"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Small label",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Sheer Roots International"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "More than a product, a living legacy"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Size",
          "options": [
            {
              "value": "h3",
              "label": "Small"
            },
            {
              "value": "h2",
              "label": "Medium"
            },
            {
              "value": "h1",
              "label": "Large"
            },
            {
              "value": "h0",
              "label": "Extra large"
            }
          ],
          "default": "h1"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading level",
          "info": "Affects SEO and screen readers, not the visible size. Use H1 once per page.",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>When you choose a piece from Sheer Roots or Social India Craft, you are choosing more than an object.</p>"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Size",
          "options": [
            {
              "value": "",
              "label": "Regular"
            },
            {
              "value": "subheading",
              "label": "Large"
            }
          ],
          "default": ""
        }
      ]
    },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "You are not merely acquiring a vessel; you are taking home a living legacy of human resilience, sacred geometry and the quiet artistry of master hands."
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Attribution"
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show quote mark",
          "default": true
        }
      ]
    },
    {
      "type": "rule",
      "name": "Divider"
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop the collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Solid"
            },
            {
              "value": "secondary",
              "label": "Outline"
            },
            {
              "value": "link",
              "label": "Text link"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    },
    {
      "name": "Pull quote",
      "settings": {
        "color_scheme": "sand"
      },
      "blocks": [
        {
          "type": "quote"
        }
      ]
    }
  ]
}
{% endschema %}
