            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "strapline",
      "name": "Tagline",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tagline",
          "default": "More than a product, a living legacy"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
