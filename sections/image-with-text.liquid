      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Social India Craft"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Size",
          "options": [
            {
              "value": "h3",
