{{ 'section-media-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ratio_class = 'media--portrait'
  case section.settings.image_ratio
    when 'square'
      assign ratio_class = 'media--square'
    when 'landscape'
      assign ratio_class = 'media--landscape'
    when 'adapt'
      assign ratio_class = 'media--adapt'
  endcase
-%}

<div
  class="section media-text scheme-{{ section.settings.color_scheme }} media-text--image-{{ section.settings.image_position }} media-text--media-{{ section.settings.media_width }}{% if section.settings.full_width %} media-text--full{% endif %}"
  {% render 'section-styles', cfg: section.settings %}
>
  <div class="{% if section.settings.full_width %}page-width page-width--flush{% else %}page-width{% endif %}">
    <div class="media-text__grid{% if settings.animations_enabled %} scroll-reveal{% endif %}">
      <div class="media-text__media">
        <div class="media {{ ratio_class }}">
          {% render 'banner-image',
            desktop_image: section.settings.desktop_image,
            mobile_image: section.settings.mobile_image,
            alt: section.settings.image_alt,
            sizes: '(min-width: 990px) 50vw, 100vw',
            placeholder: 'lifestyle-2'
          %}
        </div>
        {%- if section.settings.caption != blank -%}
          <p class="media-text__caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
      </div>

      <div class="media-text__content align-{{ section.settings.text_alignment }}{% if section.settings.text_alignment_mobile != blank %} align-mobile-{{ section.settings.text_alignment_mobile }}{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'logo' -%}
              {%- assign logo = block.settings.image | default: settings.sic_logo -%}
              {%- if logo != blank -%}
                <div
                  class="media-text__logo"
                  style="--block-logo-width: {{ block.settings.width }}px;"
                  {{ block.shopify_attributes }}
                >
                  {{
                    logo
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '120, 180, 240, 320, 480, 600',
                      sizes: '200px',
                      alt: block.settings.image_alt
                  }}
                </div>
              {%- endif -%}

            {%- when 'eyebrow' -%}
              <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>

            {%- when 'heading' -%}
              <{{ block.settings.heading_tag }}
                class="media-text__heading {{ block.settings.heading_size }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.heading | escape -}}
              </{{ block.settings.heading_tag }}>

            {%- when 'text' -%}
              <div class="media-text__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'quote' -%}
              <blockquote class="media-text__quote pull-quote" {{ block.shopify_attributes }}>
                <p>{{ block.settings.quote | escape }}</p>
              </blockquote>

            {%- when 'strapline' -%}
              <p class="media-text__strapline" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>

            {%- when 'button' -%}
              <div class="section__actions" {{ block.shopify_attributes }}>
                <a
                  class="button{% if block.settings.style == 'secondary' %} button--secondary{% elsif block.settings.style == 'link' %} button--link{% endif %}"
                  {% if block.settings.link != blank %}
                    href="{{ block.settings.link }}"
                  {% else %}
                    href="#" role="link" aria-disabled="true"
                  {% endif %}
                >
                  {{- block.settings.label | escape -}}
                </a>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "shopify-section--media-text",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Optional. Use when the desktop crop does not work on a narrow screen."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "info": "Falls back to the alt text set on the file in Content → Files."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption under the image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "adapt",
          "label": "Use the image's own shape"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "info": "On mobile the image always sits above the text.",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "Image width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text alignment (mobile)",
      "options": [
        {
          "value": "",
          "label": "Same as desktop"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make the section full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
