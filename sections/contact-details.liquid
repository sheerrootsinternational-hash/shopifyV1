{{ 'template-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign address = section.settings.address | default: settings.contact_address
  assign phone = section.settings.phone | default: settings.contact_phone
  assign phone_secondary = section.settings.phone_secondary
  assign email = section.settings.email | default: settings.contact_email
-%}

<div
  class="section contact-details scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', cfg: section.settings %}
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="section__header align-center">
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="subheading rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="contact-details__grid" role="list">
      {%- if address != blank -%}
        <li class="contact-details__item">
          {% render 'icon', name: 'location' %}
          <h3 class="contact-details__label">{{ section.settings.address_label | escape }}</h3>
          <p class="contact-details__value">{{ address | newline_to_br }}</p>
          {%- if section.settings.map_link != blank -%}
            <a class="button button--link" href="{{ section.settings.map_link }}" target="_blank" rel="noopener noreferrer">
              {{- 'sections.contact.directions' | t -}}
            </a>
          {%- endif -%}
        </li>
      {%- endif -%}

      {%- if phone != blank -%}
        <li class="contact-details__item">
          {% render 'icon', name: 'phone' %}
          <h3 class="contact-details__label">{{ section.settings.phone_label | escape }}</h3>
          <p class="contact-details__value">
            <a href="tel:{{ phone | remove: ' ' | remove: '-' }}">{{ phone }}</a>
          </p>
          {%- if phone_secondary != blank -%}
            <p class="contact-details__value">
              <a href="tel:{{ phone_secondary | remove: ' ' | remove: '-' }}">{{ phone_secondary }}</a>
            </p>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <p class="contact-details__note text-muted">{{ section.settings.hours | escape }}</p>
          {%- endif -%}
        </li>
      {%- endif -%}

      {%- if email != blank -%}
        <li class="contact-details__item">
          {% render 'icon', name: 'email' %}
          <h3 class="contact-details__label">{{ section.settings.email_label | escape }}</h3>
          <p class="contact-details__value">
            <a href="mailto:{{ email }}">{{ email }}</a>
          </p>
        </li>
      {%- endif -%}
    </ul>

    {%- if section.settings.map_image != blank -%}
      <div class="contact-details__map media media--landscape">
        {%- if section.settings.map_link != blank -%}
          <a href="{{ section.settings.map_link }}" target="_blank" rel="noopener noreferrer">
        {%- endif -%}
        {{
          section.settings.map_image
          | image_url: width: 2000
          | image_tag:
            loading: 'lazy',
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '100vw',
            alt: section.settings.map_alt
        }}
        {%- if section.settings.map_link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact details",
  "tag": "section",
  "class": "shopify-section--contact-details",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "paragraph",
      "content": "Leave the fields below empty to use Theme settings → Contact details."
    },
    {
      "type": "header",
      "content": "Location"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "Label",
      "default": "Where we are"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "url",
      "id": "map_link",
      "label": "Map link"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Map image",
      "info": "A static map screenshot keeps the page fast and avoids third-party cookies."
    },
    {
      "type": "text",
      "id": "map_alt",
      "label": "Map description"
    },
    {
      "type": "header",
      "content": "Phone"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Label",
      "default": "Call us"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "text",
      "id": "phone_secondary",
      "label": "Second phone number"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Opening hours"
    },
    {
      "type": "header",
      "content": "Email"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Label",
      "default": "Email us"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "sand"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 44
    }
  ],
  "presets": [
    {
      "name": "Contact details"
    }
  ]
}
{% endschema %}
