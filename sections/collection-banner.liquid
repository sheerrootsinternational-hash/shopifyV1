{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign banner_image = section.settings.desktop_image | default: collection.image
  assign heading = section.settings.heading | default: collection.title
-%}

<div
  class="section collection-banner scheme-{{ section.settings.color_scheme }}{% if banner_image != blank %} collection-banner--with-image{% endif %}"
  {% render 'section-styles', padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}
  style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  {%- if banner_image != blank -%}
    <div class="collection-banner__media">
      {% render 'banner-image',
        desktop_image: banner_image,
        mobile_image: section.settings.mobile_image,
        alt: '',
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        class: 'collection-banner__image'
      %}
      <span class="collection-banner__overlay" aria-hidden="true"></span>
    </div>
  {%- endif -%}

  <div class="page-width collection-banner__content align-{{ section.settings.text_alignment }}">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs' %}
    {%- endif -%}

    <h1 class="collection-banner__heading h1">{{ heading | escape }}</h1>

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-banner__description rte">{{ collection.description }}</div>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="collection-banner__description rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "shopify-section--collection-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the collection's name."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the collection description",
      "info": "Edit it in Shopify admin → Products → Collections.",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Extra text"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Leave empty to use the collection's own image, if it has one."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 35
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "sand"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
