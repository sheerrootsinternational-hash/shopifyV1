{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer
  class="footer scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', cfg: section.settings %}
>
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          <div class="footer__column footer__column--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                {%- liquid
                  assign footer_logo = settings.logo_footer | default: settings.logo
                -%}
                {%- if block.settings.show_logo and footer_logo != blank -%}
                  <div class="footer__logo" style="--footer-logo-width: {{ block.settings.logo_width }}px;">
                    {{
                      footer_logo
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '140, 200, 300, 400, 600',
                        sizes: '200px',
                        alt: shop.name
                    }}
                  </div>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.tagline != blank -%}
                  <p class="footer__tagline">{{ block.settings.tagline | escape }}</p>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {% render 'social-icons', class: 'footer__social' %}
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- liquid
                  assign address = block.settings.address | default: settings.contact_address
                  assign phone = block.settings.phone | default: settings.contact_phone
                  assign email = block.settings.email | default: settings.contact_email
                -%}
                <ul class="footer__contact" role="list">
                  {%- if address != blank -%}
                    <li class="footer__contact-item">
                      {% render 'icon', name: 'location' %}
                      <span>{{ address }}</span>
                    </li>
                  {%- endif -%}
                  {%- if phone != blank -%}
                    <li class="footer__contact-item">
                      {% render 'icon', name: 'phone' %}
                      <a href="tel:{{ phone | remove: ' ' | remove: '-' }}">{{ phone }}</a>
                    </li>
                  {%- endif -%}
                  {%- if email != blank -%}
                    <li class="footer__contact-item">
                      {% render 'icon', name: 'email' %}
                      <a href="mailto:{{ email }}">{{ email }}</a>
                    </li>
                  {%- endif -%}
                </ul>

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {{ 'sections.footer.rights' | t }}
      </p>

      {%- if section.settings.show_policy_links -%}
        {%- assign policies = shop.policies | where: 'body' -%}
        {%- if policies.size > 0 -%}
          <ul class="footer__policies" role="list">
            {%- for policy in policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment">
          <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
          <ul class="footer__payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show store policy links",
      "info": "Policies are written in Shopify admin → Settings → Policies.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ink"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_logo",
          "label": "Show logo",
          "info": "Set the footer logo in Theme settings → Branding.",
          "default": true
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 80,
          "max": 320,
          "step": 10,
          "unit": "px",
          "label": "Logo width",
          "default": 180
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>This website is operated by Sheer Roots International. Sheer Roots International offers Indian handicrafts, artisanal products, culturally inspired products, lifestyle products and gifting collections. Social India Craft operates under the Sheer Roots family and represents our premium artisanal and conscious gifting collections.</p>"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Every piece. A story. India."
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Manage the links in Shopify admin → Content → Menus.",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact us"
        },
        {
          "type": "paragraph",
          "content": "Leave these empty to use Theme settings → Contact details."
        },
        {
          "type": "text",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
