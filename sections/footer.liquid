{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Footer.

  Each column is its own block so the merchant can edit, reorder, add or remove
  them independently in the Theme Editor. The desktop grid template is built
  from the blocks actually present, which keeps the layout correct when a
  column is removed or reordered instead of assuming there are always four.
{%- endcomment -%}

{%- liquid
  assign section_align = section.settings.text_alignment | default: 'left'

  # Column weights: the content column carries the most copy, the logo column
  # the least. Built from the live block list so removing a block cannot leave
  # an empty grid track behind.
  assign column_template = ''
  for block in section.blocks
    case block.type
      when 'logo'
        assign weight = '0.7fr'
      when 'brand'
        assign weight = '1.7fr'
      when 'menu'
        assign weight = '1fr'
      when 'contact'
        assign weight = '1.2fr'
      else
        assign weight = '1fr'
    endcase
    assign column_template = column_template | append: ' minmax(0, ' | append: weight | append: ')'
  endfor
-%}

{%- capture footer_vars -%}
  {%- if column_template != blank %}--footer-columns-desktop:{{ column_template }};{% endif -%}
  {%- if section.settings.column_gap_mobile != blank %}--footer-gap-mobile: {{ section.settings.column_gap_mobile }}px;{% endif -%}
{%- endcapture -%}

<footer
  class="footer scheme-{{ section.settings.color_scheme }}"
  {% render 'section-styles', cfg: section.settings, extra: footer_vars %}
>
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_align = block.settings.text_alignment | default: section_align
            assign block_align_mobile = section.settings.text_alignment_mobile
          -%}
          {%- capture block_vars -%}
            {%- if block.settings.heading_color != blank %}--heading-color: {{ block.settings.heading_color }};{% endif -%}
            {%- if block.settings.text_color != blank %}--fg-muted: {{ block.settings.text_color }};{% endif -%}
          {%- endcapture -%}
          <div
            class="footer__column footer__column--{{ block.type }} align-{{ block_align }}{% if block_align_mobile != blank %} align-mobile-{{ block_align_mobile }}{% endif %}"
            {% if block_vars != blank %}style="{{ block_vars }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- case block.type -%}
              {%- when 'logo' -%}
                {%- liquid
                  assign logo_image = block.settings.image | default: settings.logo_footer | default: settings.logo
                  assign logo_link = block.settings.link | default: routes.root_url
                  assign logo_alt = block.settings.image_alt | default: shop.name
                  assign logo_align = block.settings.alignment | default: block_align
                -%}
                {%- if block.settings.show_logo and logo_image != blank -%}
                  {%- capture logo_sizes -%}{{ block.settings.width }}px{%- endcapture -%}
                  <div
                    class="footer__logo align-{{ logo_align }}"
                    style="--footer-logo-width: {{ block.settings.width }}px;"
                  >
                    <a class="footer__logo-link" href="{{ logo_link }}">
                      {{
                        logo_image
                        | image_url: width: 640
                        | image_tag:
                          loading: 'lazy',
                          widths: '120, 180, 240, 320, 480, 640',
                          sizes: logo_sizes,
                          alt: logo_alt,
                          class: 'footer__logo-image'
                      }}
                    </a>
                  </div>
                {%- endif -%}

              {%- when 'brand' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.tagline != blank -%}
                  <p class="footer__tagline">{{ block.settings.tagline | escape }}</p>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {% render 'social-icons', class: 'footer__social' %}
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- liquid
                  assign address = block.settings.address | default: settings.contact_address
                  assign phone = block.settings.phone | default: settings.contact_phone
                  assign email = block.settings.email | default: settings.contact_email
                -%}
                <ul class="footer__contact" role="list">
                  {%- if address != blank -%}
                    <li class="footer__contact-item">
                      {% render 'icon', name: 'location' %}
                      <span>{{ address }}</span>
                    </li>
                  {%- endif -%}
                  {%- if phone != blank -%}
                    <li class="footer__contact-item">
                      {% render 'icon', name: 'phone' %}
                      <a href="tel:{{ phone | remove: ' ' | remove: '-' }}">{{ phone }}</a>
                    </li>
                  {%- endif -%}
                  {%- if email != blank -%}
                    <li class="footer__contact-item">
                      {% render 'icon', name: 'email' %}
                      <a href="mailto:{{ email }}">{{ email }}</a>
                    </li>
                  {%- endif -%}
                </ul>

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {{ 'sections.footer.rights' | t }}
      </p>

      {%- if section.settings.show_policy_links -%}
        {%- assign policies = shop.policies | where: 'body' -%}
        {%- if policies.size > 0 -%}
          <ul class="footer__policies" role="list">
            {%- for policy in policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment">
          <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
          <ul class="footer__payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show store policy links",
      "info": "Policies are written in Shopify admin → Settings → Policies.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "wide", "label": "Wide" },
        { "value": "contained", "label": "Contained" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Column gap (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Column gap (mobile)",
      "info": "The vertical space between the stacked columns.",
      "default": 32
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment (desktop)",
      "info": "Each block can override this.",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Alignment (mobile)",
      "options": [
        { "value": "", "label": "Same as desktop" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "ink"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_logo",
          "label": "Show logo",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo",
          "info": "Leave empty to use the footer logo, then the main logo, from Theme settings → Branding."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Logo description",
          "info": "Falls back to the shop name."
        },
        {
          "type": "range",
          "id": "width",
          "min": 60,
          "max": 320,
          "step": 10,
          "unit": "px",
          "label": "Logo width",
          "default": 160
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Logo alignment",
          "options": [
            { "value": "", "label": "Use the footer alignment" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right", "label": "Right" }
          ],
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to link to the home page."
        }
      ]
    },
    {
      "type": "brand",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>This website is operated by Sheer Roots International. Sheer Roots International offers Indian handicrafts, artisanal products, culturally inspired products, lifestyle products and gifting collections. Social India Craft operates under the Sheer Roots family and represents our premium artisanal and conscious gifting collections.</p>"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Every piece. A story. India."
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "info": "Links are set in Theme settings → Social media.",
          "default": true
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "", "label": "Use the footer alignment" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right", "label": "Right" }
          ],
          "default": ""
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading colour"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text colour"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Manage the links in Shopify admin → Content → Menus.",
          "default": "footer"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "", "label": "Use the footer alignment" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right", "label": "Right" }
          ],
          "default": ""
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact us"
        },
        {
          "type": "paragraph",
          "content": "Leave these empty to use Theme settings → Contact details."
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "", "label": "Use the footer alignment" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centre" },
            { "value": "right", "label": "Right" }
          ],
          "default": ""
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "text_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "", "label": "Use the footer alignment" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centre" },
