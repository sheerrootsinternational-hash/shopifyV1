{{ 'template-page.css' | asset_url | stylesheet_tag }}

<article class="section article" {% render 'section-styles', cfg: section.settings %}>
  <div class="page-width">
    {% render 'breadcrumbs' %}

    <header class="article__header align-center">
      <p class="article-card__meta">{{ article.published_at | date: format: 'date' }}</p>
      <h1 class="h1">{{ article.title | escape }}</h1>
      {%- if section.settings.show_author and article.author != blank -%}
        <p class="text-muted">{{ 'blogs.article.by_author' | t: author: article.author }}</p>
      {%- endif -%}
    </header>

    {%- if article.image -%}
      <div class="media media--landscape article__image">
        {{
          article.image
          | image_url: width: 1600
          | image_tag:
            loading: 'eager',
            widths: '500, 800, 1100, 1400, 1600',
            sizes: '(min-width: 990px) 820px, 100vw',
            alt: article.image.alt | default: article.title
        }}
      </div>
    {%- endif -%}

    <div class="article__content rte">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <section class="article__comments" aria-labelledby="CommentsHeading">
        <h2 id="CommentsHeading" class="h3">
          {{ 'blogs.comments.title' | t: count: article.comments_count }}
        </h2>

        {%- if article.comments_count > 0 -%}
          <ul class="article__comment-list" role="list">
            {%- for comment in article.comments -%}
              <li class="article__comment">
                <p class="article__comment-author">{{ comment.author }}</p>
                <div class="rte">{{ comment.content }}</div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- form 'new_comment', article, class: 'article__comment-form' -%}
          {%- if form.errors -%}
            <div class="form__message form__message--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- elsif form.posted_successfully? -%}
            <div class="form__message form__message--success" role="status">
              {{ 'blogs.comments.success' | t }}
            </div>
          {%- endif -%}

          <div class="field">
            <label class="field__label" for="CommentAuthor">{{ 'blogs.comments.name' | t }}</label>
            <input id="CommentAuthor" class="field__input" type="text" name="comment[author]" required>
          </div>
          <div class="field">
            <label class="field__label" for="CommentEmail">{{ 'blogs.comments.email' | t }}</label>
            <input id="CommentEmail" class="field__input" type="email" name="comment[email]" required>
          </div>
          <div class="field">
            <label class="field__label" for="CommentBody">{{ 'blogs.comments.message' | t }}</label>
            <textarea id="CommentBody" class="field__input" name="comment[body]" required></textarea>
          </div>
          <button type="submit" class="button">{{ 'blogs.comments.post' | t }}</button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Blog post",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show the author",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "range",
      "id": "content_width_custom",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Custom content width",
      "info": "Only used when Content width is set to Custom.",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "info": "Automatically capped on small screens so it cannot cause sideways scrolling.",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "ivory",
          "label": "Ivory"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "ivory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override",
      "info": "Leave empty to use the colour scheme above."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Heading size",
      "default": 100
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "Text size",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 52
    }
  ],
  "enabled_on": {
    "templates": [
      "article"
    ]
  }
}
{% endschema %}
