<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value | money }} &ndash; {{ shop.name }}</title>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% render 'theme-tokens' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'template-page.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
