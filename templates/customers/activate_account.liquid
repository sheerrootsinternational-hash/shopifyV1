{{ 'template-page.css' | asset_url | stylesheet_tag }}

<div class="section" style="--section-padding-top: 64px; --section-padding-bottom: 88px;">
  <div class="page-width">
    <div class="customer">
      <h1 class="h2">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="text-muted">{{ 'customer.activate_account.subtext' | t }}</p>

      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
          <input id="ActivatePassword" class="field__input" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>

        <div class="field">
          <label class="field__label" for="ActivatePasswordConfirm">
            {{ 'customer.activate_account.password_confirm' | t }}
          </label>
          <input
            id="ActivatePasswordConfirm"
            class="field__input"
            type="password"
            name="customer[password_confirmation]"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="customer__actions">
          <button type="submit" class="button">{{ 'customer.activate_account.submit' | t }}</button>
          <button type="submit" name="decline" class="button button--link">
            {{ 'customer.activate_account.decline' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
