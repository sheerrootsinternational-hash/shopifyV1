{{ 'template-page.css' | asset_url | stylesheet_tag }}

<div class="section" style="--section-padding-top: 64px; --section-padding-bottom: 88px;">
  <div class="page-width">
    <div class="customer">
      <h1 class="h2">{{ 'customer.register.title' | t }}</h1>

      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input id="RegisterFirstName" class="field__input" type="text" name="customer[first_name]" autocomplete="given-name">
        </div>

        <div class="field">
          <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input id="RegisterLastName" class="field__input" type="text" name="customer[last_name]" autocomplete="family-name">
        </div>

        <div class="field">
          <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
          <input
            id="RegisterEmail"
            class="field__input"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
          >
        </div>

        <div class="field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
          <input
            id="RegisterPassword"
            class="field__input"
            type="password"
            name="customer[password]"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="customer__actions">
          <button type="submit" class="button">{{ 'customer.register.submit' | t }}</button>
          <a class="button button--link" href="{{ routes.account_login_url }}">
            {{ 'customer.register.sign_in' | t }}
          </a>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
