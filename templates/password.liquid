{% layout 'password' %}

<div class="section password" style="--section-padding-top: 96px; --section-padding-bottom: 96px;">
  <div class="page-width page-width--narrow align-center">
    {%- if settings.logo != blank -%}
      <div class="password__logo" style="--logo-width: {{ settings.logo_width }}px;">
        {{
          settings.logo
          | image_url: width: 700
          | image_tag: loading: 'eager', widths: '200, 300, 400, 560, 700', sizes: '240px', alt: shop.name
        }}
      </div>
    {%- else -%}
      <h1 class="h1">{{ shop.name }}</h1>
    {%- endif -%}

    <div class="rte password__message">{{ shop.password_message }}</div>

    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
          {{ form.errors.messages.form }}
        </div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="StorefrontPassword">{{ 'general.password_page.password' | t }}</label>
        <input
          id="StorefrontPassword"
          class="field__input"
          type="password"
          name="password"
          autocomplete="current-password"
          required
        >
      </div>

      <button type="submit" class="button">{{ 'general.password_page.enter' | t }}</button>
    {%- endform -%}

    <p class="text-muted password__admin">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</div>
